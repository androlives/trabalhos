{
  "info": {
    "name": "Controle de Tarefas",
    "description": "Requisições para reproduzir as demonstrações dos 16 requisitos. Execute os comandos na raiz do projeto (pasta do pom.xml). Suba a API: ./mvnw quarkus:dev. O mock nao sobe automaticamente com a API e deve ser iniciado em outro terminal: Linux/macOS -> java mock/PrioridadeMock.java ; Windows (cmd.exe) -> java mock\\PrioridadeMock.java 8089. Na pasta 4, rode o primeiro request com mock UP; depois encerre o mock (Ctrl+C) e rode o segundo para validar o fallback.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "tarefaId",
      "value": ""
    },
    {
      "key": "tarefaRegraId",
      "value": ""
    },
    {
      "key": "metricaAntes",
      "value": "0"
    }
  ],
  "item": [
    {
      "name": "1. CRUD e transações",
      "description": "Roteiro obrigatório: POST cria; GET recupera; PUT altera; segundo GET comprova; DELETE remove; GET final retorna 404.",
      "item": [
        {
          "name": "POST criar tarefa (201 + Location)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tarefas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tarefas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Estudar Quarkus\",\n  \"descricao\": \"Revisar aulas 01 a 06\",\n  \"prioridade\": \"ALTA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Header Location presente', () => pm.response.to.have.header('Location'));",
                  "const j = pm.response.json(); pm.collectionVariables.set('tarefaId', j.id);",
                  "pm.test('Status inicial ABERTA', () => pm.expect(j.status).to.eql('ABERTA'));"
                ]
              }
            }
          ]
        },
