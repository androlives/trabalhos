    {
      "name": "4. Integração externa",
      "description": "Mock em processo separado, porta 8089: Linux/macOS -> java mock/PrioridadeMock.java ; Windows (cmd.exe) -> java mock\\PrioridadeMock.java 8089. Execute o primeiro request com mock UP e, depois de encerrar o mock (Ctrl+C), execute o segundo para validar fallback MEDIA.",
      "item": [
        {
          "name": "GET mock direto (diagnóstico 8089)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8089/prioridades/sugestao?titulo=bug%20urgente",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8089",
              "path": [
                "prioridades",
                "sugestao"
              ],
              "query": [
                {
                  "key": "titulo",
                  "value": "bug urgente"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Mock respondeu prioridade', () => pm.expect(j.prioridade).to.be.oneOf(['ALTA', 'MEDIA', 'BAIXA']));",
                  "pm.test('Origem mock', () => pm.expect(j.origem).to.eql('mock'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST sem prioridade, mock UP (espera ALTA)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tarefas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tarefas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Corrigir bug urgente\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test('Prioridade veio do serviço externo', () => pm.expect(j.prioridade).to.eql('ALTA'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST sem prioridade, mock DOWN (fallback MEDIA)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tarefas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tarefas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Corrigir bug urgente com mock desligado\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Fallback aplicado', () => pm.expect(pm.response.json().prioridade).to.eql('MEDIA'));",
                  "pm.test('Resposta controlada, sem erro 5xx', () => pm.expect(pm.response.code).to.be.below(500));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST com prioridade informada (não consulta o serviço)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tarefas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tarefas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Prioridade explícita\",\n  \"prioridade\": \"BAIXA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Prioridade mantida', () => pm.expect(pm.response.json().prioridade).to.eql('BAIXA'));"
                ]
              }
            }
          ]
        }
      ]
    },
